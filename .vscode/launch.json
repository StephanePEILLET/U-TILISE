    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Train U-TILISE",
            "type": "debugpy",
            "request": "launch",
            "preLaunchTask": "clean_training",
            "program": "run_train.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_circa_train.yaml",
                "--save_dir",
                "/home/SPeillet/Downloads/data/outputs/train",
            ]
        },
        {
            "name": "Eval U-TILISE",
            "type": "debugpy",
            "request": "launch",
            "program": "run_eval.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/inference_circa.yaml",
                "utilise",
                "--checkpoint",
                "/home/SPeillet/Downloads/data/outputs/U-TILISE/_RESULTS/ALL_BANDS_120_epochs_2025-07-11_18-05/checkpoints/Model_best.pth",
                "--test-data.test-config",
                "/home/SPeillet/Downloads/data/outputs/U-TILISE/_RESULTS/ALL_BANDS_120_epochs_2025-07-11_18-05/config.yaml",
                "--test-data.hdf5-file-read",
                "/home/SPeillet/Downloads/data/circa_cloud_removal.hdf5",
                "--test-data.mode",
                "test",
                "--test-data.split",
                "test",
            ]
        },
    ]
}