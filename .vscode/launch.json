    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Train U-TILISE",
            "type": "debugpy",
            "request": "launch",
            "preLaunchTask": "clean_training",
            "program": "run_train.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_circa_train.yaml",
                "--save_dir",
                "/home/SPeillet/Downloads/data/outputs/train",
            ]
        },
    ]
}