{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Train U-TILISE",
            "type": "debugpy",
            "request": "launch",
            "preLaunchTask": "clean_training",
            "program": "run_train.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_run_train.yaml",
                "--save_dir",
                "/mnt/DATA_10T/data_rpg/outputs/train",
            ]
        },
        {
            "name": "Eval U-TILISE",
            "type": "debugpy",
            "request": "launch",
            "program": "run_eval.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_run_eval.yaml",
                "utilise",
                // "--checkpoint",
                // "/DATA_10TB/data_rpg/outputs/U-TILISE/results/BGR_NIR_SAR_120_epochs_2025-07-11_16-56/checkpoints/Model_best.pth",
                // "/DATA_10TB/data_rpg/outputs/U-TILISE/results/ALL_BANDS_120_epochs_2025-07-11_18-05/checkpoints/Model_best.pth",
                // "--test-data.test-config",
                // "/DATA_10TB/data_rpg/outputs/U-TILISE/results/BGR_NIR_SAR_120_epochs_2025-07-11_16-56/config.yaml",
                // "/DATA_10TB/data_rpg/outputs/U-TILISE/results/ALL_BANDS_120_epochs_2025-07-11_18-05/config.yaml",
                // "--test-data.hdf5-file-read",
                // "/DATA_10TB/data_rpg/circa/hdf5/circa_cloud_removal.hdf5",
                // "--test-data.split",
                // "test",
            ]
        },
        {
            "name": "Eval U-TILISE best",
            "type": "debugpy",
            "request": "launch",
            "program": "run_eval.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_run_eval_best.yaml",
                "utilise",
            ]
        },
        {
            "name": "Inference U-TILISE",
            "type": "debugpy",
            "request": "launch",
            "program": "inference_full_tile.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_run_inference.yaml",
                "utilise",
            ]
        },
        {
            "name": "Inference from tiles",
            "type": "debugpy",
            "request": "launch",
            "program": "infer_from_tiles.py",
            "console": "integratedTerminal",
            "args": [
                "./configs/config_run_infer_from_tiles.yaml",
                "utilise",
            ]
        },
    ]
}