# =============================================================================
# Variables d'environnement machine-spécifiques pour U-TILISE
# Copier ce fichier en .env et adapter les chemins à votre installation :
#   cp .env.example .env
# Ces variables sont utilisées dans les configs YAML via ${oc.env:VAR_NAME}
# =============================================================================

# --- Données ---
# Fichier HDF5 fusionné contenant les données S1/S2
HDF5_FILE=/mnt/DATA_10T/data_rpg/circa/hdf5/CIRCA_CR_merged.hdf5
# Fichier JSON des transformations géométriques par patch
LOAD_TRANSFORMS=./metadata/patches_with_transforms.json

# --- Sorties ---
# Répertoire racine pour les résultats (entraînement, métriques, inférence)
OUTPUT_DIR=/mnt/DATA_10T/data_rpg/outputs/U-TILISE

# --- Évaluation / Inférence ---
# Checkpoint du modèle entraîné (.pth)
CHECKPOINT=/chemin/vers/checkpoints/Model_best.pth
# Config sauvegardée durant l'entraînement (dans le répertoire d'expérience)
TRAIN_CONFIG=/chemin/vers/experience/config.yaml

# --- Données raster (inférence à la tuile) ---
# Répertoire des données optiques Sentinel-2 (GeoTIFF)
DATA_OPTIQUE=/chemin/vers/optique_dataset
# Répertoire des données radar Sentinel-1 (GeoTIFF)
DATA_RADAR=/chemin/vers/radar_dataset_v4
